bin/
obj/
*.user
*.suo
.vs/
.idea/
.vscode/

# Node is only needed to regenerate artifacts/; nothing here ships.
node_modules/
build/vendor/.entries/
build/vendor/.esbuild-tmp/
build/proof/.out/

# artifacts/ IS checked in on purpose -- it is the prebuilt payload the tool embeds,
# so CI, contributors and end users never need node. Regenerate with:
#   cd build/vendor && npm install && node build-all.mjs
# The one exception is the esbuild binaries: 74 MB of Go binaries across 7 RIDs is not
# something to carry in git history. CI and `dotnet build` fetch them on demand via
# `node build/vendor/fetch-esbuild.mjs`.
artifacts/esbuild/

# Output from scripts/agent-wireframe.ps1
wireframes/

# Generated by the vendor build scripts when run standalone.
build/vendor/.facades/
build/proof/.url.txt

# Studio UI build scratch.
build/studio/.out/

# Memtrace's local code-index store, created when its MCP server attaches to this
# workspace. 70 MB of database rebuilt from the source tree on demand -- local state,
# not a project artefact.
.memdb/
.memtrace/
